<div class="row"><div class="field" style="flex:2"><label>Nom du groupe</label><input type="text" name="name" value="<%= g.name || '' %>" required placeholder="A1 – Abendkurs"></div>
  <div class="field"><label>Niveau</label><select name="level"><% LEVELS.forEach(l => { %><option <%= g.level === l ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
  <div class="field"><label>Professeur</label><select name="teacher_id"><option value="">—</option><% teachers.forEach(t => { %><option value="<%= t.id %>" <%= g.teacher_id === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %></select></div></div>
<div class="row"><div class="field" style="flex:2"><label>Horaires</label><input type="text" name="schedule" value="<%= g.schedule || '' %>" placeholder="Lun/Mer/Ven 18:00–20:00"></div>
  <div class="field"><label>Début</label><input type="date" name="start_date" value="<%= g.start_date || '' %>"></div>
  <div class="field"><label>Fin</label><input type="date" name="end_date" value="<%= g.end_date || '' %>"></div></div>
