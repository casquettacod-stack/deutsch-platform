<%- include('../partials/head') %>
<main class="wrap">
  <div class="crumbs"><a href="/teach">Professeur</a> / <%= group.name %></div>
  <div class="page-head"><div><h1><%= group.name %> <span class="badge lvl lvl-<%= group.level %>"><%= group.level %></span></h1><p class="muted" style="margin:0"><%= group.schedule || '' %> <%= group.teacher ? '· ' + group.teacher : '' %></p></div></div>
  <%- include('../partials/flash') %>
  <div class="card"><h2>Carnet de notes</h2>
    <div class="table-wrap"><table>
      <tr><th>Étudiant</th><% titles.forEach(t => { %><th><%= t %></th><% }) %><th>Moyenne /20</th></tr>
      <% matrix.forEach(m => { %><tr><td><a href="/teach/students/<%= m.id %>"><%= m.name %></a></td>
        <% m.cells.forEach(c => { %><td><%= c ? c.score + '/' + c.max_score : '—' %></td><% }) %>
        <td><strong><%= m.avg ?? '—' %></strong></td></tr><% }) %>
    </table></div>
    <% if (!members.length) { %><div class="empty">Aucun étudiant dans ce groupe.</div><% } %>
  </div>
  <% if (members.length) { %>
  <div class="card"><h2>Saisir une note</h2>
    <p class="muted small">Pour un examen oral (Sprechen), un devoir ou un test en classe. Saisir le même titre remplace la note existante.</p>
    <form method="post" action="/teach/groups/<%= group.id %>/grades"><%- include('../partials/csrf') %>
      <div class="row">
        <div class="field" style="flex:3"><label>Titre de l'évaluation</label><input type="text" name="title" required list="titles" placeholder="Mündliche Prüfung Modul 1"><datalist id="titles"><% titles.forEach(t => { %><option value="<%= t %>"><% }) %></datalist></div>
        <div class="field"><label>Compétence</label><select name="skill"><option value="">—</option><% SECTIONS.forEach(s => { %><option><%= s %></option><% }) %></select></div>
        <div class="field" style="flex:0 1 110px"><label>Sur</label><input type="number" name="max_score" value="20" min="1" step="0.5"></div>
      </div>
      <div class="table-wrap"><table>
        <% members.forEach(m => { %><tr><td><%= m.name %></td><td style="width:120px"><input type="number" step="0.25" min="0" name="score[k<%= m.id %>]"></td><td><input type="text" name="comment[k<%= m.id %>]" placeholder="Commentaire (optionnel)"></td></tr><% }) %>
      </table></div>
      <p><button class="btn">Enregistrer les notes</button></p>
    </form>
  </div>
  <% } %>
</main>
<%- include('../partials/foot') %>
