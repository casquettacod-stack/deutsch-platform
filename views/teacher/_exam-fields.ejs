<div class="field"><label>Titre</label><input type="text" name="title" value="<%= exam.title || '' %>" required placeholder="Modelltest A1 – Start Deutsch 1"></div>
<div class="row">
  <div class="field"><label>Type</label><select name="kind"><% Object.entries(KIND).forEach(([k, v]) => { %><option value="<%= k %>" <%= exam.kind === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
  <div class="field"><label>Niveau</label><select name="level"><% LEVELS.forEach(l => { %><option <%= exam.level === l ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
</div>
<div class="field"><label>Rattaché au cours</label><select name="course_id"><option value="">Aucun – visible par tous les étudiants de ce niveau</option><% courses.forEach(c => { %><option value="<%= c.id %>" <%= exam.course_id === c.id ? 'selected' : '' %>><%= c.level %> · <%= c.title %></option><% }) %></select></div>
<div class="row">
  <div class="field"><label>Durée (min)</label><input type="number" name="duration_min" min="1" value="<%= exam.duration_min %>"></div>
  <div class="field"><label>Seuil de réussite (%)</label><input type="number" name="pass_percent" min="0" max="100" value="<%= exam.pass_percent %>"></div>
  <div class="field"><label>Tentatives max</label><input type="number" name="max_attempts" min="0" value="<%= exam.max_attempts %>"><div class="help">0 = illimité</div></div>
</div>
<div class="field"><label>Consignes</label><textarea name="description"><%= exam.description || '' %></textarea></div>
<label class="check"><input type="checkbox" name="published" value="1" <%= exam.published ? 'checked' : '' %>> Publié (visible par les étudiants)</label>
