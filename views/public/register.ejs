<%- include('../partials/head') %>
<main class="wrap"><div class="card auth">
  <h1>Créer un compte</h1>
  <p class="muted">Créez votre compte étudiant, puis passez le test de niveau.</p>
  <%- include('../partials/flash') %>
  <form method="post" action="/register">
    <%- include('../partials/csrf') %>
    <div class="field"><label>Nom complet *</label><input type="text" name="name" required maxlength="120"></div>
    <div class="field"><label>E-mail *</label><input type="email" name="email" required autocomplete="username"></div>
    <div class="field"><label>Téléphone</label><input type="tel" name="phone" maxlength="40"></div>
    <div class="field"><label>Mot de passe * <span class="muted">(8 caractères min.)</span></label><input type="password" name="password" required minlength="8" autocomplete="new-password"></div>
    <div class="field"><label>Confirmer le mot de passe *</label><input type="password" name="password2" required minlength="8" autocomplete="new-password"></div>
    <button class="btn block lg">Créer mon compte</button>
  </form>
  <p class="small muted" style="margin-top:16px">Déjà inscrit ? <a href="/login">Se connecter</a></p>
</div></main>
<%- include('../partials/foot') %>
