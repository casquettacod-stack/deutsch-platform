# --- Copiez ce fichier en .env et remplissez les valeurs ---
NODE_ENV=production
CENTER_NAME=Deutschzentrum
# Votre nom de domaine (ex: plateforme.moncentre.ma). Laissez ":80" pour tester avec l'IP sans HTTPS.
DOMAIN=:80
# Mettre HTTPS=false tant que vous utilisez l'IP sans domaine (sinon la connexion ne marche pas)
HTTPS=false
# Générez avec : openssl rand -hex 32
SESSION_SECRET=CHANGEZ-MOI
ADMIN_EMAIL=admin@moncentre.ma
ADMIN_PASSWORD=ChangezCeMotDePasse!
# true = les étudiants peuvent créer leur compte eux-mêmes
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=50
TZ=Africa/Casablanca
